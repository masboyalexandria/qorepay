# QorePay — copy to .env and fill in. QoreChain diana TESTNET only.
# Throwaway keys. Never commit, never fund on mainnet.
QORE_NETWORK=testnet

# Owner (guardian): a throwaway testnet account.
# PRIVATE_KEY = 0x + 64 hex chars; QORE_PQC_RECOVERY_CODE = QRC1... code.
OWNER_PRIVATE_KEY=
OWNER_PQC_RECOVERY_CODE=

# Agent (scheduler): created by `pnpm agent init`.
AGENT_PRIVATE_KEY=
AGENT_PQC_RECOVERY_CODE=

# Filled in by `pnpm agent deploy`.
VAULT_ADDRESS=
VAULT_DEPLOY_BLOCK=
